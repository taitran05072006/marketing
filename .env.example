# ==============================================================================
# ENVIRONMENT VARIABLES — Production
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ==============================================================================

# --- MySQL ---
MYSQL_DATABASE=marketing
MYSQL_ROOT_PASSWORD=change-this-strong-root-password
MYSQL_USER=appuser
MYSQL_PASSWORD=change-this-strong-app-password

# --- Spring Boot ---
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-64-chars-for-hs512-security
JWT_EXPIRATION=86400000

# --- URLs & Network Mapping ---
# Frontend URL (cho CORS backend)
FRONTEND_URL=https://yourdomain.com
# Site URL (cho Next.js metadata/sitemap)
SITE_URL=https://yourdomain.com
SITE_NAME=YLAN

# Dia chi backend Spring Boot noi bo cho Next.js SSR fetch (chay trong Docker network)
INTERNAL_API_URL=http://backend:8080

# Dia chi backend cong khai cho trinh duyet goi (qua Nginx reverse proxy hoac domain)
NEXT_PUBLIC_API_URL=/api

# --- Webhook Revalidation (Spring Boot -> Next.js) ---
# Endpoint de Spring Boot gui webhook invalidation toi Next.js
NEXTJS_REVALIDATE_URL=http://nextjs:3000/api/revalidate
# Secret token xac thuc webhook (bat buoc trung khop giua Spring Boot va Next.js)
NEXTJS_REVALIDATE_SECRET=change-this-to-a-strong-random-secret

# --- Cloudinary (for image upload) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- PayOS (for payment) ---
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này: cp .env.example .env
# 2. Điền tất cả giá trị thực vào .env
# 3. Đảm bảo .env đã có trong .gitignore (KHÔNG commit .env)
# 4. JWT_SECRET cần ít nhất 64 ký tự random
# 5. Tất cả password phải mạnh: >= 16 ký tự, hỗn hợp chữ/số/ký tự đặc biệt
# ==============================================================================

# --- Google AdSense ---
NEXT_PUBLIC_ADSENSE_ID=pub-0000000000000000
